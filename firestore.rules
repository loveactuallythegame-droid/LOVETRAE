rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read and write their own profile.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Couples, game_sessions, and sos_fights can only be accessed by the partners.
    match /couples/{coupleId} {
      allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.partners;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.partners;
      allow update: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.partners;
      allow delete: if false;
    }

    match /game_sessions/{sessionId} {
      allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/game_sessions/$(sessionId)).data.partners;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.partners;
      // This rule allows any partner to update the entire game session.
      // For stricter validation to prevent a user from modifying their partner's score,
      // more complex rules would be needed to inspect the data being changed.
      allow update: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/game_sessions/$(sessionId)).data.partners;
      allow delete: if false;
    }

    match /sos_fights/{fightId} {
       allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/sos_fights/$(fightId)).data.partners;
       allow create: if request.auth != null && request.auth.uid in request.resource.data.partners;
       allow update: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/sos_fights/$(fightId)).data.partners;
       allow delete: if false;
    }
  }
}